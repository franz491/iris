{
  "name": "@iris/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig tsconfig.json",
    "lint": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "performance:check": "vitest run --config vitest.config.ts tests/participant-index.performance.test.ts",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
    "rust:check": "pnpm run format:check && pnpm run rust:clippy && pnpm run rust:test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "better-auth": "^1.7.2",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "happy-dom": "^20.12.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
